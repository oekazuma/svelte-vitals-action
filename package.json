{
  "name": "@svelte-vitals/action",
  "version": "0.15.2",
  "private": true,
  "type": "module",
  "description": "First-party GitHub Action running svelte-vitals in CI — annotations, job summary, sticky PR comment.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oekazuma/svelte-vitals-action.git"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node test/e2e/run.mjs",
    "lint": "oxlint . && oxfmt --check .",
    "format": "oxfmt --write .",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "dependencies": {
    "svelte-vitals": "^0.56.1",
    "@svelte-vitals/core": "^0.56.1",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.19.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
